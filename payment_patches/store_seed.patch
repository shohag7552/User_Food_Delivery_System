+/// Waits until [keys] on [tableId] are `available` (Appwrite builds columns in
+/// the background), giving up after about 30 seconds.
+Future<void> _waitForColumns(TablesDB db, String tableId, List<String> keys) async {
+  for (var attempt = 0; attempt < 30; attempt++) {
+    try {
+      final list = await db.listColumns(databaseId: AppwriteConfig.dbId, tableId: tableId);
+      final ready = list.columns
+          .whereType<Map>()
+          .where((c) => keys.contains(c['key']) && c['status'] == 'available')
+          .length;
+      if (ready == keys.length) return;
+    } catch (_) {
+      // Retried below.
+    }
+    await Future.delayed(const Duration(seconds: 1));
+  }
+  print("   ⚠️ Columns ${keys.join(', ')} on '$tableId' are still not available");
+}
