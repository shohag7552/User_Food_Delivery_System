+/// One row per card checkout, written by the backend function's
+/// start_online_order before the customer pays. The Stripe function charges
+/// its total_amount (never an amount from the app) and its webhook marks it
+/// confirmed or cancelled; the backend turns a paid row into a real order and
+/// marks it converted. Nothing here touches stock or the store's order lists.
+/// Server key only: no client may read or write it.
+Future<void> _setupPendingOrders(TablesDB db) async {
+  const t = AppwriteConfig.pendingOrdersCollection;
+  await _createCollection(db, t, 'Pending Orders', [
+        () => db.createStringColumn(databaseId: AppwriteConfig.dbId, tableId: t, key: 'customer_id', size: 64, xrequired: true),
+        // awaiting_payment → confirmed | cancelled → converted
+        () => db.createStringColumn(databaseId: AppwriteConfig.dbId, tableId: t, key: 'status', size: 32, xrequired: true),
+        () => db.createStringColumn(databaseId: AppwriteConfig.dbId, tableId: t, key: 'payment_method', size: 16, xrequired: true),
+        () => db.createStringColumn(databaseId: AppwriteConfig.dbId, tableId: t, key: 'payment_status', size: 16, xrequired: true),
+        () => db.createFloatColumn(databaseId: AppwriteConfig.dbId, tableId: t, key: 'total_amount', xrequired: true),
+        () => db.createStringColumn(databaseId: AppwriteConfig.dbId, tableId: t, key: 'currency_code', size: 3, xrequired: true),
+        // JSON: checkout choices, cart snapshot (≤ 100 lines) and server totals.
+        () => db.createStringColumn(databaseId: AppwriteConfig.dbId, tableId: t, key: 'payload', size: 1000000, xrequired: true),
+        () => db.createStringColumn(databaseId: AppwriteConfig.dbId, tableId: t, key: 'created_at', size: 64, xrequired: true),
+        () => db.createStringColumn(databaseId: AppwriteConfig.dbId, tableId: t, key: 'payment_ref', size: 255, xrequired: false),
+        () => db.createStringColumn(databaseId: AppwriteConfig.dbId, tableId: t, key: 'order_id', size: 64, xrequired: false),
+        () => db.createStringColumn(databaseId: AppwriteConfig.dbId, tableId: t, key: 'order_number', size: 32, xrequired: false),
+  ], const []);
+}
