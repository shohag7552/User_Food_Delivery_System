new file mode 100644
index 0000000..a3067d9
--- /dev/null
+++ b/pending.go
@@ -0,0 +1,349 @@
+package handler
+
+// Online (card) checkout with server-side pricing.
+//
+//  1. start_online_order prices the customer's cart here and stores the
+//     result in pending_orders, a table no client can read or write.
+//  2. The app asks the payment function for a checkout session for that row's
+//     id. The payment function charges the row's total_amount in its
+//     currency_code; the app never sends an amount.
+//  3. After payment, place_order with pending_order_id writes the real order
+//     from the stored row (its cart snapshot and its totals), so the order is
+//     exactly what was paid for, whatever happened to the cart meanwhile.
+//
+// Nothing reaches `orders` before payment, so stock, order numbers and the
+// store's order lists only ever see paid orders.
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/appwrite/sdk-for-go/appwrite"
+	"github.com/open-runtimes/types-for-go/v4/openruntimes"
+)
+
+const (
+	pendingOrdersTable   = "pending_orders"
+	pendingAwaiting      = "awaiting_payment"
+	pendingConverted     = "converted"
+	pendingCancelled     = "cancelled"
+	defaultStoreCurrency = "USD"
+
+	// The webhook path waits up to convertAttempts × convertRetryDelay for an
+	// in-flight app attempt; keep it inside the function's timeout.
+	convertAttempts   = 4
+	convertRetryDelay = 3 * time.Second
+)
+
+// pendingFields are the checkout choices stored with a pending order and
+// replayed into place_order. Anything else the app sends is ignored.
+var pendingFields = []string{
+	"module_type", "address_id", "coupon_id", "shipping_method_id",
+	"delivery_type", "scheduled_date", "scheduled_time_slot",
+	"scheduled_start", "scheduled_end", "delivery_instructions",
+}
+
+// cartSnapshotKeys are the cart_items columns cartLineFromRow reads.
+var cartSnapshotKeys = []string{
+	"$id", "product_id", "product_name", "product_image", "quantity",
+	"selected_variants", "base_price", "final_price",
+}
+
+// zeroDecimalCurrencies have no minor unit (Stripe's list; keep it in step
+// with the payment function).
+var zeroDecimalCurrencies = map[string]bool{
+	"BIF": true, "CLP": true, "DJF": true, "GNF": true, "JPY": true,
+	"KMF": true, "KRW": true, "MGA": true, "PYG": true, "RWF": true,
+	"UGX": true, "VND": true, "VUV": true, "XAF": true, "XOF": true,
+	"XPF": true,
+}
+
+// toMinor converts a major-unit amount to the gateway's minor units, the same
+// way the payment function does.
+func toMinor(total float64, currency string) int64 {
+	if zeroDecimalCurrencies[strings.ToUpper(strings.TrimSpace(currency))] {
+		return int64(math.Round(total))
+	}
+	return int64(math.Round(total * 100))
+}
+
+// storeCurrency is the ISO 4217 code online payments are charged in.
+func storeCurrency() string {
+	c := strings.ToUpper(strings.TrimSpace(os.Getenv("STORE_CURRENCY")))
+	if len(c) != 3 {
+		return defaultStoreCurrency
+	}
+	return c
+}
+
+type pendingTotals struct {
+	Total          float64 `json:"total"`
+	DeliveryFee    float64 `json:"delivery_fee"`
+	Tax            float64 `json:"tax"`
+	ItemDiscount   float64 `json:"item_discount"`
+	CouponDiscount float64 `json:"coupon_discount"`
+}
+
+// pendingPayload is the JSON kept in pending_orders.payload.
+type pendingPayload struct {
+	Fields map[string]string        `json:"fields"`
+	Cart   []map[string]interface{} `json:"cart"`
+	Totals pendingTotals            `json:"totals"`
+}
+
+type pendingOrder struct {
+	id       string
+	currency string
+	payload  pendingPayload
+}
+
+func buildPendingPayload(body map[string]interface{}, cart []map[string]interface{}, t *orderTotals) pendingPayload {
+	p := pendingPayload{
+		Fields: map[string]string{},
+		Cart:   []map[string]interface{}{},
+		Totals: pendingTotals{
+			Total:          round2(t.Total),
+			DeliveryFee:    round2(t.DeliveryFee),
+			Tax:            round2(t.Tax),
+			ItemDiscount:   round2(t.ItemDiscount),
+			CouponDiscount: round2(t.CouponDiscount),
+		},
+	}
+	for _, k := range pendingFields {
+		if v := bodyString(body, k); v != "" {
+			p.Fields[k] = v
+		}
+	}
+	for _, row := range cart {
+		line := map[string]interface{}{}
+		for _, k := range cartSnapshotKeys {
+			if v, ok := row[k]; ok {
+				line[k] = v
+			}
+		}
+		p.Cart = append(p.Cart, line)
+	}
+	return p
+}
+
+// placeBody is the place_order body for a paid pending order: only the stored
+// choices plus the payment the app reports. The app's own fields are dropped.
+func (p *pendingOrder) placeBody(sessionID string) map[string]interface{} {
+	body := map[string]interface{}{}
+	for k, v := range p.payload.Fields {
+		body[k] = v
+	}
+	body["payment_method"] = payOnline
+	body["payment_session_id"] = sessionID
+	body["payment_reference"] = p.id
+	// One order per pending order, however often the app retries.
+	body["request_id"] = p.id
+	return body
+}
+
+// charge is what the order is written with: exactly what was paid.
+func (p *pendingOrder) charge() clientTotals {
+	t := p.payload.Totals
+	return clientTotals{
+		Total:          t.Total,
+		DeliveryFee:    t.DeliveryFee,
+		Tax:            t.Tax,
+		ItemDiscount:   t.ItemDiscount,
+		CouponDiscount: t.CouponDiscount,
+	}
+}
+
+// paidInFull reports whether a verified gateway payment covers this pending
+// order exactly: same reference, same currency, same amount.
+func (p *pendingOrder) paidInFull(c *paymentCheck) bool {
+	return c.paid &&
+		c.reference == p.id &&
+		strings.EqualFold(c.currency, p.currency) &&
+		c.amountMinor == toMinor(p.payload.Totals.Total, p.currency)
+}
+
+func startOnlineOrder(a *api, body map[string]interface{}) (interface{}, error) {
+	cart, err := a.readCart(moduleOf(body))
+	if err != nil {
+		return nil, err
+	}
+	in, _, err := a.loadPricing(body, cart)
+	if err != nil {
+		return nil, err
+	}
+	// The server's prices are always binding here, whatever SECURITY_ENFORCE
+	// says: this total is what the card is charged.
+	t, err := computeTotals(in)
+	if err != nil {
+		return nil, asPriceError(err)
+	}
+	total := round2(t.Total)
+	if _, sent := body["expected_total"]; sent && math.Abs(num(body["expected_total"])-total) > priceTolerance {
+		e := fail(409, "price_changed", "Prices changed. Please review your order.")
+		e.data = map[string]interface{}{"totals": t}
+		return nil, e
+	}
+	if total <= 0 {
+		return nil, fail(400, "amount_too_small", "Nothing to pay online for this order.")
+	}
+
+	payload, err := json.Marshal(buildPendingPayload(body, cart, t))
+	if err != nil {
+		return nil, fmt.Errorf("encode pending order: %w", err)
+	}
+	currency := storeCurrency()
+	row, err := a.db.CreateRow(a.databaseID, pendingOrdersTable, "unique()", map[string]interface{}{
+		"customer_id":    a.uid,
+		"status":         pendingAwaiting,
+		"payment_method": payOnline,
+		"payment_status": "unpaid",
+		"total_amount":   total,
+		"currency_code":  currency,
+		"payload":        string(payload),
+		"created_at":     a.now.Format("2006-01-02T15:04:05.000Z"),
+	}, a.db.WithCreateRowPermissions([]string{})) // server key only
+	if err != nil {
+		return nil, fmt.Errorf("create pending order (is the pending_orders table created? run the seed script): %w", err)
+	}
+	return map[string]interface{}{
+		"pending_order_id": row.Id,
+		"total_amount":     total,
+		"currency_code":    currency,
+		"totals":           t,
+	}, nil
+}
+
+// loadPendingOrder reads a pending order the caller owns and may still turn
+// into an order.
+func (a *api) loadPendingOrder(id string) (*pendingOrder, error) {
+	row, err := a.getRow(pendingOrdersTable, id)
+	if err != nil {
+		if statusOf(err) == 404 {
+			return nil, fail(404, "payment_unverified", "Payment could not be confirmed.")
+		}
+		return nil, fmt.Errorf("read pending order: %w", err)
+	}
+	return pendingFromRow(id, row, a.uid)
+}
+
+// pendingFromRow checks ownership and state and decodes the stored payload.
+func pendingFromRow(id string, row map[string]interface{}, uid string) (*pendingOrder, error) {
+	if str(row["customer_id"]) != uid {
+		return nil, fail(403, "payment_unverified", "Payment could not be confirmed.")
+	}
+	if strings.EqualFold(str(row["status"]), pendingCancelled) {
+		return nil, fail(409, "payment_unverified", "This payment was cancelled.")
+	}
+	p := &pendingOrder{id: id, currency: str(row["currency_code"])}
+	if err := json.Unmarshal([]byte(str(row["payload"])), &p.payload); err != nil {
+		return nil, fmt.Errorf("decode pending order %s: %w", id, err)
+	}
+	if p.payload.Cart == nil {
+		p.payload.Cart = []map[string]interface{}{} // never fall back to the live cart
+	}
+	return p, nil
+}
+
+// markPendingConverted records which order a paid pending order became.
+// Best effort: the order exists either way.
+func (a *api) markPendingConverted(p *pendingOrder, orderID, orderNumber, paymentRef string) {
+	if _, err := a.db.UpdateRow(a.databaseID, pendingOrdersTable, p.id,
+		a.db.WithUpdateRowData(map[string]interface{}{
+			"status":         pendingConverted,
+			"payment_status": "paid",
+			"order_id":       orderID,
+			"order_number":   orderNumber,
+			"payment_ref":    paymentRef,
+		})); err != nil {
+		a.ctx.Error(fmt.Sprintf("place_order: pending order %s not marked converted: %v", p.id, err))
+	}
+}
+
+// shouldConvert reports whether a pending_orders row is paid and still waits
+// to become an order (the Stripe webhook sets confirmed + paid).
+func shouldConvert(row map[string]interface{}) bool {
+	return strings.EqualFold(str(row["status"]), "confirmed") &&
+		strings.EqualFold(str(row["payment_status"]), "paid")
+}
+
+// convertPaidPending runs on the pending_orders update event. When the Stripe
+// webhook has marked a row paid, it writes the order through place_order as
+// that customer, so a customer whose app closed after paying still gets their
+// order. The app reports the same payment itself; place_order's idempotency
+// key (the pending id) lets exactly one of the two write the order.
+func convertPaidPending(ctx openruntimes.Context, databaseID string, row map[string]interface{}) error {
+	if !shouldConvert(row) {
+		return nil
+	}
+	id, customer, session := str(row["$id"]), str(row["customer_id"]), str(row["payment_ref"])
+	if id == "" || customer == "" || session == "" {
+		return fmt.Errorf("pending order %q is paid but has no customer or payment_ref", id)
+	}
+	var (
+		res interface{}
+		err error
+	)
+	// While the customer's app is writing the same order, wait for it: if that
+	// attempt fails it releases the key and this one writes the order instead.
+	for attempt := 1; ; attempt++ {
+		res, err = placeOrder(newAPI(ctx, customer, databaseID), map[string]interface{}{
+			"pending_order_id":   id,
+			"payment_session_id": session,
+		})
+		var ae *apiError
+		if err == nil || !errors.As(err, &ae) || ae.code != "order_in_progress" || attempt == convertAttempts {
+			break
+		}
+		time.Sleep(convertRetryDelay)
+	}
+	if err != nil {
+		return fmt.Errorf("PAID PENDING ORDER %s NOT CONVERTED (customer %s, session %s) — check the payment and place or refund it: %w",
+			id, customer, session, err)
+	}
+	ctx.Log(fmt.Sprintf("pending order %s converted from the payment webhook: %v", id, res))
+	return nil
+}
+
+// announceOrder pushes "order placed" to the customer and "new order" to the
+// store topic. Best effort: an order must never fail over a notification.
+func (a *api) announceOrder(orderNumber string) {
+	key := strings.TrimSpace(os.Getenv("APPWRITE_API_KEY")) // needs messages.write
+	if key == "" {
+		a.ctx.Error("announceOrder: APPWRITE_API_KEY is not set; order " + orderNumber + " was not announced")
+		return
+	}
+	m := appwrite.NewMessaging(appwrite.NewClient(
+		appwrite.WithEndpoint(os.Getenv("APPWRITE_API_ENDPOINT")),
+		appwrite.WithProject(os.Getenv("APPWRITE_FUNCTION_PROJECT_ID")),
+		appwrite.WithKey(key),
+	))
+	data := map[string]interface{}{"click_action": "FLUTTER_NOTIFICATION_CLICK", "order_id": orderNumber}
+
+	data["type"] = "order_update"
+	if _, err := m.CreatePush("unique()",
+		m.WithCreatePushTitle("Order Placed Successfully!"),
+		m.WithCreatePushBody(fmt.Sprintf("We will deliver your order #%s soon.", orderNumber)),
+		m.WithCreatePushUsers([]string{a.uid}),
+		m.WithCreatePushData(data)); err != nil {
+		a.ctx.Error("announceOrder: customer push for order " + orderNumber + ": " + err.Error())
+	}
+
+	topic := strings.TrimSpace(os.Getenv("STORE_ADMIN_TOPIC_ID"))
+	if topic == "" {
+		a.ctx.Error("announceOrder: STORE_ADMIN_TOPIC_ID is not set; the store was not told about order " + orderNumber)
+		return
+	}
+	storeData := map[string]interface{}{"click_action": "FLUTTER_NOTIFICATION_CLICK", "order_id": orderNumber, "type": "broadcast"}
+	if _, err := m.CreatePush("unique()",
+		m.WithCreatePushTitle("New Order!"),
+		m.WithCreatePushBody(fmt.Sprintf("Order #%s has been placed. Tap to view.", orderNumber)),
+		m.WithCreatePushTopics([]string{topic}),
+		m.WithCreatePushData(storeData)); err != nil {
+		a.ctx.Error("announceOrder: store push for order " + orderNumber + ": " + err.Error())
+	}
+}
