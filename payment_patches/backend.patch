+func TestBuildPendingPayloadKeepsOnlyKnownFields(t *testing.T) {
+	body := map[string]interface{}{
+		"module_type": "food", "address_id": "addr1", "coupon_id": "c1",
+		"expected_total": 1.0, "payment_method": "cod", "total_amount": 0.01, // ignored
+	}
+	cart := []map[string]interface{}{{
+		"$id": "l1", "product_id": "p1", "quantity": 2.0, "final_price": 5.0,
+		"user_id": "u1", "$permissions": []string{"x"}, // dropped
+	}}
+	p := buildPendingPayload(body, cart, &orderTotals{Total: 10.004, DeliveryFee: 2, Tax: 0.5})
+
+	if len(p.Fields) != 3 || p.Fields["address_id"] != "addr1" || p.Fields["coupon_id"] != "c1" {
+		t.Fatalf("fields: %v", p.Fields)
+	}
+	if _, ok := p.Fields["payment_method"]; ok {
+		t.Fatal("payment_method must not be stored")
+	}
+	if len(p.Cart) != 1 || p.Cart[0]["user_id"] != nil || p.Cart[0]["product_id"] != "p1" {
+		t.Fatalf("cart: %v", p.Cart)
+	}
+	if p.Totals.Total != 10 || p.Totals.DeliveryFee != 2 || p.Totals.Tax != 0.5 {
+		t.Fatalf("totals: %+v", p.Totals)
+	}
+	// The cart snapshot must survive the JSON round trip into cartLineFromRow.
+	raw, _ := json.Marshal(p)
+	var back pendingPayload
+	if err := json.Unmarshal(raw, &back); err != nil {
+		t.Fatal(err)
+	}
+	if l := cartLineFromRow(back.Cart[0]); l.productID != "p1" || l.quantity != 2 || l.snapshotFinal != 5 {
+		t.Fatalf("line: %+v", l)
+	}
+}
