+func TestShouldConvert(t *testing.T) {
+	for _, c := range []struct {
+		status, payment string
+		want            bool
+	}{
+		{"confirmed", "paid", true},
+		{"awaiting_payment", "unpaid", false},
+		{"converted", "paid", false}, // already an order: the update this function makes itself
+		{"cancelled", "unpaid", false},
+		{"confirmed", "unpaid", false},
+	} {
+		if got := shouldConvert(map[string]interface{}{"status": c.status, "payment_status": c.payment}); got != c.want {
+			t.Errorf("%s/%s: got %v", c.status, c.payment, got)
+		}
+	}
